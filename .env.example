# Права доступа (строки проверяются через $user->can(...) — совместимо со spatie/laravel-permission и Gate).
# broadcasts.view — доступ к ресурсу «Рассылки»;
# broadcasts.create — создание рассылки;
# broadcasts.send — (зарезервировано) отправка;
# broadcasts.manage — действия «Повторить»/«Отправить сейчас»/«Отменить»/«Удалить».
FILAMENT_MAX_BROADCASTS_PERMISSION_VIEW=
FILAMENT_MAX_BROADCASTS_PERMISSION_CREATE=
FILAMENT_MAX_BROADCASTS_PERMISSION_SEND=
FILAMENT_MAX_BROADCASTS_PERMISSION_MANAGE=

# Модель пользователя (создатель рассылки) для связи created_by в max_broadcasts.
# По умолчанию Illuminate\Foundation\Auth\User — переопределяйте своей моделью (App\Models\User).
FILAMENT_MAX_BROADCASTS_USER_MODEL=

# Кнопки-диплинки акций (тип «Акция»): публичное имя бота для ссылок https://max.ru/<bot>?startapp=...
# По умолчанию пусто — кнопок нет. Хост настраивает под свой мини-апп.
FILAMENT_MAX_BROADCASTS_BOT_USERNAME=

# Диск и каталог загрузки фото рассылки + лимит размера в КБ.
FILAMENT_MAX_BROADCASTS_IMAGE_DISK=
FILAMENT_MAX_BROADCASTS_IMAGE_DIRECTORY=
FILAMENT_MAX_BROADCASTS_IMAGE_MAX_KB=
