# Эталон имён переменных плагина, а не готовый .env для копирования целиком.
# Переносите в .env только те строки, которые меняете: заданная переменная
# перекрывает дефолт из config/filament-max-broadcasts.php, поэтому пустое
# значение (KEY=) — это пустая строка, а не «взять дефолт».

# Права доступа (строки проверяются через $user->can(...) — совместимо со spatie/laravel-permission и Gate).
# Схема имён как в laravel-max-client: MAX_PERMISSION_<RESOURCE>_<ABILITY>.
# max_broadcasts.view — доступ к ресурсу «Рассылки»;
# max_broadcasts.create — создание рассылки;
# max_broadcasts.manage — действия «Повторить»/«Отправить сейчас»/«Отменить»/«Удалить».
MAX_PERMISSION_BROADCASTS_VIEW=
MAX_PERMISSION_BROADCASTS_CREATE=
MAX_PERMISSION_BROADCASTS_MANAGE=

# Модель пользователя (создатель рассылки) для связи created_by в max_broadcasts.
# По умолчанию Illuminate\Foundation\Auth\User — переопределяйте своей моделью (App\Models\User).
MAX_BROADCASTS_USER_MODEL=

# Кнопки-диплинки (по типу рассылки): публичное имя бота для ссылок https://max.ru/<bot>?startapp=...
# Общий ключ приложения, чтобы диплинки совпадали с ботом хоста. По умолчанию пусто — кнопок нет.
# Хост настраивает бота и список кнопок на тип в config buttons.per_type.
# Типы как поведение — это классы BroadcastTypeContract в config types; у типа можно переопределить
# label/badgeColor/buttonRows, не меняя конфиг и код пакета.
MAX_BOT_USERNAME=

# Вложения рассылки (картинки, видео, файлы — по несколько на рассылку).
# Диск и каталог хранения файлов; лимит размера одного файла в КБ (лимит MAX — 50 МБ).
# Диск может быть локальным (публичным или приватным) либо объектным хранилищем (S3 и подобные):
# для объектного хранилища файл перед отправкой скачивается во временную локальную копию.
# По умолчанию (если переменная не задана) используется приватный диск local: файлы
# видны только в админке по временным подписанным ссылкам, в MAX они уходят через uploadMedia.
# Для предпросмотра на local нужен 'serve' => true в config/filesystems.php (значение по умолчанию в Laravel 11+).
MAX_BROADCASTS_IMAGE_DISK=
MAX_BROADCASTS_IMAGE_DIRECTORY=
MAX_BROADCASTS_IMAGE_MAX_KB=
